# Copy to .env and fill in. Never commit the real .env.

# --- Django ---
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,web
LOG_LEVEL=INFO

# --- Datastores ---
DATABASE_URL=postgresql://build:build@postgres:5432/build_service
CELERY_BROKER_URL=redis://redis:6379/0

# --- Build execution ---
BUILD_WORKSPACE_ROOT=/tmp/builds
GIT_TIMEOUT_SECONDS=120

# --- Internal service-to-service auth (Jenkins -> this service) ---
INTERNAL_SERVICE_TOKEN=change-me
BUILD_CALLBACK_BASE_URL=http://web:8000

# --- Jenkins (build engine) ---
JENKINS_URL=http://jenkins:8080
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB_NAME=build-image
JENKINS_TIMEOUT_SECONDS=30

# --- Registry naming (credentials live in Jenkins only) ---
DOCKERHUB_NAMESPACE=example
PLATFORM_NAME=iiap
