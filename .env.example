# Django / PostgreSQL
SECRET_KEY=change-me
DATABASE_URL=postgres://build:build@postgres:5432/build_service
DEBUG=false

# Celery broker (Redis)
CELERY_BROKER_URL=redis://redis:6379/0

# Build workspace / git
BUILD_WORKSPACE_ROOT=/tmp/builds
GIT_TIMEOUT_SECONDS=60

# Jenkins access
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Callback + internal auth
BUILD_CALLBACK_BASE_URL=
INTERNAL_SERVICE_TOKEN=change-me

# Image naming
DOCKERHUB_NAMESPACE=
PLATFORM_NAME=

# Application / Deployment services
APP_SERVICE_URL=
APP_SERVICE_TOKEN=
DEPLOYMENT_QUEUE=deployment
