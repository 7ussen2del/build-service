# --- Django -----------------------------------------------------------------
DEBUG=true
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (owned exclusively by the Build Service) --------------------
# Used when Django runs natively on your machine. Inside Docker Compose the
# URL is assembled from POSTGRES_* below, so the host is always `postgres`.
DATABASE_URL=postgres://build:build@localhost:5432/build_service
POSTGRES_USER=build
POSTGRES_PASSWORD=build
POSTGRES_DB=build_service

# --- Celery / Redis ---------------------------------------------------------
# Natively: redis://localhost:6379/0. Compose hardcodes redis://redis:6379/0.
CELERY_BROKER_URL=redis://localhost:6379/0
# Left empty on purpose: build state lives in PostgreSQL, not in the broker.
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# --- Build pipeline ---------------------------------------------------------
BUILD_WORKSPACE_ROOT=/tmp/builds
TEMPLATES_ROOT=./build_templates
ACTIVE_TEMPLATE_VERSIONS=django=v1,flask=v1,node=v1,react=v1
MAX_REPO_SIZE_MB=100
GIT_TIMEOUT_SECONDS=60

# --- Internal auth (Phase 10 callback, Phase 12 read API) -------------------
INTERNAL_SERVICE_TOKEN=dev-internal-token
