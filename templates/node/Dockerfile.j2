# Generated by the Build Service. Do not edit by hand.
FROM {{ base_image }}

ENV NODE_ENV=production

WORKDIR /app

COPY {{ source_directory }} ./

# npm ci requires a lockfile; fall back to install when the repo has none.
RUN if [ -f package-lock.json ]; then \
        npm ci --omit=dev; \
    else \
        npm install --omit=dev; \
    fi

EXPOSE {{ port }}

CMD {{ run_command }}
