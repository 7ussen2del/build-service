# Generated by the Build Service. Do not edit by hand.
#
# Two stages: build the bundle with the full toolchain, then ship only the
# static output behind `serve`. run_command is not used for react (see
# template.yaml).

FROM {{ base_image }} AS builder

WORKDIR /app

COPY {{ source_directory }} ./

RUN if [ -f package-lock.json ]; then \
        npm ci; \
    else \
        npm install; \
    fi

# Vite writes dist/, Create React App writes build/; normalise to dist/.
RUN npm run build \
    && if [ -d dist ]; then \
        :; \
    elif [ -d build ]; then \
        mv build dist; \
    else \
        echo "react build produced neither dist/ nor build/" >&2; \
        exit 1; \
    fi


FROM {{ base_image }}

ENV NODE_ENV=production

WORKDIR /app

RUN npm install --global serve@14.2.4

COPY --from=builder /app/dist ./dist

EXPOSE {{ port }}

CMD ["serve", "--single", "--listen", "tcp://0.0.0.0:{{ port }}", "./dist"]
